{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'github>camptocamp/gs-renovate-config-preset:base.json5#1.14.0',
    'github>camptocamp/gs-renovate-config-preset:group.json5#1.14.0',
    'github>camptocamp/gs-renovate-config-preset:ci.json5#1.14.0',
    'github>camptocamp/gs-renovate-config-preset:preset.json5#1.14.0',
    'github>camptocamp/gs-renovate-config-preset:pre-commit.json5#1.14.0',
    'github>camptocamp/gs-renovate-config-preset:python.json5#1.14.0',
    'github>camptocamp/gs-renovate-config-preset:json-schema.json5#1.14.0',
    'github>camptocamp/gs-renovate-config-preset:shellcheck.json5#1.14.0',
    'github>camptocamp/gs-renovate-config-preset:own.json5#1.14.0',
    'github>camptocamp/gs-renovate-config-preset:security.json5#1.14.0',
  ],
  packageRules: [
    /** Disable upgrading the supported Python version */
    {
      matchFileNames: ['pyproject.toml', '.python-version'],
      enabled: false,
      matchDepNames: ['python'],
    },
    /** Don't allows update on ubuntu:mantic-* Docker images */
    {
      matchNewValue: '!/^[0-9][0-9]\\.[0-9][0-9]$/',
      enabled: false,
      matchDepNames: ['ubuntu'],
    },
    /** Keep setuptools below 81.0.0 for pyramid */
    {
      enabled: false,
      matchDepNames: ['setuptools'],
      allowedVersions: '<81.0.0',
    },
  ],
  regexManagers: [
    {
      fileMatch: ['^github_app_geo_project/module/updates/versions.yaml$'],
      matchStrings: [
        "'?(?<depName>[a-zA-Z0-9-_/]+)'?: '?(?<currentValue>[v0-9\\.]+)'? # (?<datasource>[a-z-]+)",
      ],
      managerFilePatterns: ['/^github_app_geo_project/module/updates/versions\\.yaml$/'],
    },
    /** The fnm version used in the Docker image, from the GitHub releases */
    {
      fileMatch: ['^Dockerfile$'],
      matchStrings: ['ARG FNM_VERSION=(?<currentValue>[0-9\\.]+)'],
      managerFilePatterns: ['/^Dockerfile$/'],
      datasourceTemplate: 'github-releases',
      depNameTemplate: 'Schniz/fnm',
    },
    /**
     * The helm version and the sha256 of the linux-amd64 archive used in the Docker
     * image, both updated by the `github-release-attachments` datasource.
     */
    {
      fileMatch: ['^Dockerfile$'],
      matchStrings: [
        'ARG HELM_VERSION=(?<currentValue>v[0-9\\.]+)\n# renovate:[^\\n]*\nARG HELM_SHA256=(?<currentDigest>[a-f0-9]{64})',
      ],
      managerFilePatterns: ['/^Dockerfile$/'],
      datasourceTemplate: 'github-release-attachments',
      depNameTemplate: 'helm/helm',
      packageNameTemplate: 'helm/helm',
    },
    /**
     * The trivy version and the sha256 of the Linux-64bit archive used in the Docker
     * image, both updated by the `github-release-attachments` datasource.
     */
    {
      fileMatch: ['^Dockerfile$'],
      matchStrings: [
        'ARG TRIVY_VERSION=(?<currentValue>v[0-9\\.]+)\n# renovate:[^\\n]*\nARG TRIVY_SHA256=(?<currentDigest>[a-f0-9]{64})',
      ],
      managerFilePatterns: ['/^Dockerfile$/'],
      datasourceTemplate: 'github-release-attachments',
      depNameTemplate: 'aquasecurity/trivy',
      packageNameTemplate: 'aquasecurity/trivy',
    },
  ],
}
